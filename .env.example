# ==============================================================================
# OPEN SOURCE REALTIME VOICE AGENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in each corresponding component directory:
#   - Root or backend/.env for Node.js Token Service
#   - agent/.env for Python LiveKit Voice Agent
#   - frontend/.env for React Client
#
# SECURITY WARNING: NEVER commit .env files containing real secrets to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LIVEKIT WEBRTC INFRASTRUCTURE
# ------------------------------------------------------------------------------
# LiveKit Cloud or Self-Hosted LiveKit Server instance
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVICE (Node.js / Express / MongoDB)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/voice_agent_db
JWT_SECRET=super_secret_session_or_auth_jwt_key_min_32_chars

# ------------------------------------------------------------------------------
# 3. PYTHON VOICE AGENT CORE CONFIGURATION
# ------------------------------------------------------------------------------
AGENT_NAME=open-voice-agent
DEFAULT_LANGUAGE=en-US
# Options: 'en-US', 'hi-IN', 'auto' (for multilingual models supporting English, Hindi, Hinglish)

# VAD (Voice Activity Detection) Provider: 'silero'
VAD_PROVIDER=silero

# STT (Speech-to-Text) Provider: 'deepgram', 'whisper', 'qwen3-asr', 'local'
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM Provider: 'openai', 'groq', 'anthropic', 'ollama'
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-4o-mini

# TTS (Text-to-Speech) Provider: 'cartesia', 'elevenlabs', 'openai', 'qwen3-tts', 'local'
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=your_cartesia_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
TTS_VOICE_ID=

# ------------------------------------------------------------------------------
# 4. FRONTEND CLIENT (React + Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
